#!/bin/sh
# AI agents never commit to the default branch (owner commits are unaffected).
GUARD_REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
if ! bash "$GUARD_REPO_ROOT/scripts/agent-default-branch-guard.sh" commit; then
    echo "Pre-commit aborted: agents commit on a branch in a worktree and open a PR." >&2
    exit 1
fi

RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -z "$RUST_FILES" ]; then
    exit 0
fi

echo "Running the pinned formatter..."
if ! ./scripts/fmt.sh --check; then
    echo "Format check failed. Run: ./scripts/fmt.sh"
    exit 1
fi

echo "Running clippy with the repository toolchain..."
if ! cargo clippy --all-targets -- -D warnings; then
    echo "Clippy check failed."
    exit 1
fi
